{
  "name": "rifa-online",
  "private": true,
  "description": "Rifa Online — ferramentas de desenvolvimento e testes (o site em si não precisa de build).",
  "type": "module",
  "scripts": {
    "emuladores": "firebase emulators:start --project demo-rifa",
    "seed": "node dev/seed-emulador.mjs --config",
    "servidor": "node dev/servidor-local.mjs",
    "test": "firebase emulators:exec --project demo-rifa-testes --only firestore,storage \"node --test tests/regras.test.mjs\"",
    "deploy:regras": "firebase deploy --only firestore:rules,storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.0"
  }
}
